# Copy to frontend/.env.local. These values are PUBLIC (bundled into the website).
# Never put the data.gov.in key here; it lives only in backend/.env.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Public site origin, used for sitemap.xml and Open Graph URLs.
VITE_SITE_URL=
# Contact details. Leave blank until configured; the site shows "being set up" instead of a fake address.
VITE_CONTACT_EMAIL=
VITE_PARTNERSHIP_EMAIL=
VITE_LINKEDIN_URL=
VITE_X_URL=
VITE_INSTAGRAM_URL=
