# Copy to backend/.env and fill in. Never commit .env.
# Get a personal key at https://www.data.gov.in/ (sign in -> My Account -> API key).
DATA_GOV_API_KEY=

# AGMARKNET "Current Daily Price of Various Commodities from Various Markets (Mandi)".
# Verify against the live catalogue before relying on it.
AGMARKNET_CURRENT_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# AGMARKNET "Variety-wise Daily Market Prices Data of Commodity" (historical, filterable by date).
# UNVERIFIED: confirm on data.gov.in before running historical fetches.
AGMARKNET_HISTORY_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24

# District-wise, season-wise crop production statistics.
# UNVERIFIED: confirm on data.gov.in. A CSV downloaded from the catalogue page can be imported instead.
CROP_PRODUCTION_RESOURCE_ID=35be999b-0208-4354-b557-f6ca9a5355de

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Seconds to cache live API responses in memory (rate-limit protection).
LIVE_CACHE_TTL_SECONDS=900
HTTP_TIMEOUT_SECONDS=30

# Max API requests per minute per client IP (0 disables).
RATE_LIMIT_PER_MINUTE=120

# States processed into market_prices.parquet (empty = all India, needs ~9 GB RAM for 2022-2026).
MARKET_STATES=Telangana,Andhra Pradesh,Karnataka

# Cold-storage admin portal: password required to view telemetry and control the pump.
ADMIN_PASSWORD=
# Shared secret the ESP32 sends in the X-Device-Key header (also set in the firmware).
DEVICE_KEY=
